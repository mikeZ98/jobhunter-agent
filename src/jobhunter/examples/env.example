# Cloud fallbacks (optional, opt-in — local Ollama models are used first; a provider is only
# routed to once its key is set, and never with local_only = true). Tried in this order:
OPENROUTER_API_KEY=
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# LinkedIn inbox triage (optional). Copy from browser DevTools › Application › Cookies › linkedin.com
LINKEDIN_LI_AT=
LINKEDIN_JSESSIONID=

# Tracing (optional)
# LANGSMITH_TRACING=true
# LANGSMITH_API_KEY=
# LANGSMITH_PROJECT=jobhunter
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
