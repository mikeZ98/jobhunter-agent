# ecosystem — toolchain + caches locked INSIDE the SSD project dir.
# direnv applies/reverts these on cd so $HOME / the internal disk stay clean.
# Activate once per checkout:  direnv allow .
export XDG_CACHE_HOME="$PWD/.cache"

# Python (uv): venv, cache and bytecode pinned local; the interpreter itself comes from the
# SSD-wide install dir when the shell already provides one (shared base Python, isolated site-packages).
export UV_PROJECT_ENVIRONMENT="$PWD/.venv"
export UV_CACHE_DIR="$PWD/.cache/uv"
[[ -n "$UV_PYTHON_INSTALL_DIR" ]] || export UV_PYTHON_INSTALL_DIR="$PWD/.cache/uv-python"
export UV_LINK_MODE="copy"            # external volumes cannot hardlink across filesystems
export PIP_CACHE_DIR="$PWD/.cache/pip"

# Tool caches.
export RUFF_CACHE_DIR="$PWD/.cache/ruff"
export MYPY_CACHE_DIR="$PWD/.cache/mypy"

# Playwright browsers (~200 MB per Chromium build) default to ~/Library/Caches/ms-playwright.
# Re-install once into the project after `direnv allow`:  uv run playwright install chromium
export PLAYWRIGHT_BROWSERS_PATH="$PWD/.cache/ms-playwright"

# Temp files (pytest tmp_path, Chromium profiles, Apple Notes export) stay on the SSD too.
export TMPDIR="$PWD/.cache/tmp"
mkdir -p "$TMPDIR"

# `layout uv` — direnv dispatches `layout <name>` to `layout_<name>`; defined inline because
# direnv's stdlib does not ship it in every version.
layout_uv() {
  if [[ ! -d "$UV_PROJECT_ENVIRONMENT" ]]; then
    log_status "uv: creating virtualenv at .venv"
    uv venv --quiet "$UV_PROJECT_ENVIRONMENT"
  fi
  export VIRTUAL_ENV="$UV_PROJECT_ENVIRONMENT"
  PATH_add "$VIRTUAL_ENV/bin"
}
layout uv

# Secrets in .env are read by the app itself (pydantic-settings); they are deliberately NOT
# exported into the shell, so API keys never leak into every subprocess started from here.
watch_file pyproject.toml uv.lock
